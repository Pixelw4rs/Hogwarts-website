# Copy to .env and fill in. Docker Compose and `npm run dev` both read it.
# The admin area is off until ADMIN_PASSWORD is set. Use at least 12 characters.
ADMIN_USER=Pixel_wars
ADMIN_PASSWORD=
# 1 = always mark the login cookie Secure (needed behind https proxies that drop X-Forwarded-Proto)
COOKIE_SECURE=0
